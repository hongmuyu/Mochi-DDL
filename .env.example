# ==========================================
# 麻糬のDDL - 环境变量配置模板
# ==========================================
# 说明：本项目核心功能为 100% 离线运行，所有数据持久化在本地 SQLite 数据库中。
# 正常单机运行无需依赖任何云端后端。
#
# 若需要启用特定远程特性，请复制此文件为 .env 并填入对应凭据：
# cp .env.example .env

EXPO_PUBLIC_APP_ID=mochi-ddl
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
